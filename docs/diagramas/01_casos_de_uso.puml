@startuml casos_de_uso
!include estilo.iuml
left to right direction
title Diagrama de casos de uso — SaludIA

actor "Paciente" as PA
actor "Médico" as ME
actor "Farmacéutico" as FA
actor "Administrador" as AD
actor "Proveedor de IA\n(sistema externo)" as IA <<sistema>>

rectangle "SaludIA" {
  usecase "CU-01 Iniciar sesión" as CU01
  usecase "CU-02 Consultar\ndisponibilidad de médicos" as CU02
  usecase "CU-03 Solicitar cita" as CU03
  usecase "CU-04 Cancelar cita" as CU04
  usecase "CU-05 Obtener orientación\nde síntomas (IA)" as CU05
  usecase "CU-06 Consultar agenda" as CU06
  usecase "CU-07 Registrar diagnóstico" as CU07
  usecase "CU-08 Emitir fórmula médica" as CU08
  usecase "CU-09 Consultar mis fórmulas" as CU09
  usecase "CU-10 Dispensar medicamentos" as CU10
  usecase "CU-11 Controlar inventario\ny alertas de stock" as CU11
  usecase "CU-12 Consultar tablero\nde indicadores" as CU12
  usecase "CU-13 Monitorear estado\ndel sistema (/health)" as CU13
}

PA --> CU01
PA --> CU03
PA --> CU04
PA --> CU05
PA --> CU09
ME --> CU01
ME --> CU06
ME --> CU07
FA --> CU01
FA --> CU10
FA --> CU11
AD --> CU01
AD --> CU12
AD --> CU13

CU03 ..> CU02 : <<include>>
CU08 ..> CU07 : <<extend>>
CU10 ..> CU11 : <<include>>
CU05 --> IA
@enduml
